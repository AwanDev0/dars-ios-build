      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pages take the colour. The logo and the launch stay gold, and red, amber and green keep meaning what they mean."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پەڕەکان ڕەنگەکە وەردەگرن. لۆگۆ و دەستپێک زێڕین دەمێننەوە، و سوور، پرتەقاڵی و سەوز هەمان مانا دەپارێزن."
          }
        }
      }
    },
    "a.appearance_language_note": {
      "extractionState": "manual",
