    "a.app_lock_face_not_offered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone doesn’t offer its face unlock to apps (the maker keeps it for the lock screen), so Dars asks for a fingerprint or your PIN."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم مۆبایلە ناسینەوەی ڕووخساری بۆ ئەپەکان ناکاتەوە (کۆمپانیاکە بۆ شاشەی قفڵ دەیهێڵێتەوە)، بۆیە دەرس داوای پەنجەمۆر یان کۆدی PIN دەکات."
          }
        }
      }
    },
