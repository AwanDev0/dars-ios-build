    "a.privacy_blocked_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody you block can message you, and you won’t see each other’s messages"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کەسێک کە بلۆکی دەکەیت ناتوانێت نامەت بۆ بنێرێت، و نامەکانی یەکتر نابینن"
          }
        }
      }
    },
    "a.privacy_collect_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name, your role, your class, your marks, your attendance, and the messages you send. Your school enters most of this; you enter the rest."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناوت، ڕۆڵت، پۆلەکەت، نمرەکانت، ئامادەبوونت، و ئەو نامانەی دەیاننێریت. قوتابخانەکەت زۆربەی ئەمانە داخڵ دەکات؛ تۆ ئەوانی تر."
          }
        }
      }
    },
    "a.privacy_collect_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Dars stores"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەرس چی هەڵدەگرێت"
          }
        }
      }
    },
    "a.privacy_delete_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete your account from here at any time. Your messages, photos and voice notes go with it. Marks and registers your school keeps as its own record lose your name."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەر کاتێک بتەوێت دەتوانیت هەژمارەکەت لێرەوە بسڕیتەوە. نامە و وێنە و دەنگەکانت لەگەڵیدا دەڕۆن. نمرە و تۆماری ئامادەبوون کە قوتابخانە وەک تۆماری خۆی دەیانپارێزێت ناوی تۆیان لەسەر نامێنێت."
          }
        }
      }
    },
    "a.privacy_delete_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything about you goes, and stays gone"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەموو شتێک دەربارەی تۆ دەڕوات و ناگەڕێتەوە"
          }
        }
      }
    },
    "a.privacy_delete_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "سڕینەوەی هەژمارەکەت"
          }
        }
      }
    },
