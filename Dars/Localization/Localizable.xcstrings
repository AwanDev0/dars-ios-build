    "a.delete_account_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes your account, your messages and your marks from Dars. It cannot be undone, and your school cannot restore it."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەمە هەژمار، نامەکان و نمرەکانت لە دەرس لادەبات. ناتوانرێت بگەڕێندرێتەوە، و قوتابخانەکەشت ناتوانێت بیگەڕێنێتەوە."
          }
        }
      }
    },
    "a.delete_account_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete permanently"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بۆ هەمیشە بسڕەوە"
          }
        }
      }
    },
    "a.delete_account_last_admin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re the school’s only admin. Make another admin first, then delete your account."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تۆ تاکە بەڕێوەبەری قوتابخانەکەیت. سەرەتا بەڕێوەبەرێکی تر دابنێ، پاشان هەژمارەکەت بسڕەوە."
          }
        }
      }
    },
