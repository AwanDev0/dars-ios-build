    "a.privacy_permissions_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera reads class and family QR codes. The microphone records voice messages you choose to send. Photos are only read when you pick one. Nothing is used in the background."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کامێرا کۆدی QR ی پۆل و خێزان دەخوێنێتەوە. مایک ئەو نامە دەنگییانە تۆمار دەکات کە خۆت هەڵیدەبژێریت. وێنەکان تەنها کاتێک دەخوێنرێنەوە کە خۆت هەڵیدەبژێریت. هیچ شتێک لە پشتەوە بەکارناهێنرێت."
          }
        }
      }
    },
