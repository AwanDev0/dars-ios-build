    "a.welcome_admin_1_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Students, teachers, classes, subjects — and what happened this fortnight, under it."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "قوتابیان، مامۆستایان، پۆلەکان، بابەتەکان — و ئەوەی ئەم دوو هەفتەیە ڕوویداوە، لە ژێری."
          }
        }
      }
    },
    "a.welcome_admin_1_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The school in four numbers"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "قوتابخانە بە چوار ژمارە"
          }
        }
      }
    },
    "a.welcome_admin_2_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every student's record, every teacher's week, every reported message, from the bar."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تۆماری هەموو قوتابییەک، هەفتەی هەموو مامۆستایەک، هەموو نامەیەکی ڕاپۆرتکراو، لە شریتەکەوە."
          }
        }
      }
    },
    "a.welcome_admin_2_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People, classes, reports"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کەسەکان، پۆلەکان، ڕاپۆرتەکان"
          }
        }
      }
    },
    "a.welcome_admin_3_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announcements reach every phone; closures reach every timetable, bag and reminder."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئاگادارییەکان دەگەنە هەموو مۆبایلێک؛ داخرانەکان دەگەنە هەموو خشتە و جانتا و بیرخستنەوەیەک."
          }
        }
      }
    },
    "a.welcome_admin_3_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say it once"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "جارێک بیڵێ"
          }
        }
      }
    },
    "a.welcome_parent_1_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer is the first thing on your home, every morning, with marks and messages under it."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەڵامەکە یەکەم شتە لە ماڵەوەکەت، هەموو بەیانییەک، لەگەڵ نمرە و نامەکان لە ژێری."
          }
        }
      }
    },
    "a.welcome_parent_1_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is my child at school?"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "منداڵەکەم لە قوتابخانەیە؟"
          }
        }
      }
    },
    "a.welcome_parent_2_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day of the term, with Friday and Saturday as the weekend and closures marked as the school's."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەموو ڕۆژێکی وەرزەکە، هەینی و شەممە وەک پشووی هەفتە و داخرانەکان وەک هی قوتابخانە."
          }
        }
      }
    },
    "a.welcome_parent_2_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The register, as a calendar"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تۆماری ئامادەبوون، وەک ڕۆژژمێر"
          }
        }
      }
    },
    "a.welcome_parent_3_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short note each Thursday evening: days at school, new marks, anything waiting to be read."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تێبینییەکی کورت هەموو ئێوارەی پێنجشەممەیەک: ڕۆژەکانی قوتابخانە، نمرەی نوێ، هەرچی چاوەڕێی خوێندنەوەیە."
          }
        }
      }
    },
    "a.welcome_parent_3_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The week, on Thursday"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەفتەکە، پێنجشەممە"
          }
        }
      }
    },
    "a.welcome_start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's go"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەست پێ بکەین"
          }
        }
      }
    },
    "a.welcome_student_1_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next lesson, your bag for tomorrow, and tonight's work — before eight and after twelve, because your phone stays home."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وانەی داهاتووت، جانتاکەت بۆ سبەینێ، و کاری ئەمشەو — پێش هەشت و دوای دوانزە، چونکە مۆبایلەکەت لە ماڵ دەمێنێتەوە."
          }
        }
      }
    },
    "a.welcome_student_1_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your day, at the top"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕۆژەکەت، لە سەرەوە"
          }
        }
      }
    },
    "a.welcome_student_2_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books from the timetable, kit for PE, anything to hand in. Tick as you pack; the ring closes on Thursday."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کتێبەکان لە خشتەوە، کەلوپەل بۆ وەرزش، هەرچی تەسلیم بکرێت. کە ئامادەت کرد نیشانی بکە؛ بازنەکە پێنجشەممە داخرێت."
          }
        }
      }
    },
    "a.welcome_student_2_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
